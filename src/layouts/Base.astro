---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../consts';
import { url } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}
const { title, description = SITE.description, type = 'website', publishedTime } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og-default.png'), Astro.site);

// Strict security policy: only this site's own files may load. No trackers, no third-party scripts.
const csp = [
  "default-src 'self'",
  "script-src 'self' 'wasm-unsafe-eval'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  'upgrade-insecure-requests',
].join('; ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#16181d" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="topbar">
      <button class="menu-btn" type="button" aria-controls="sidebar" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="visually-hidden">Menu</span>
      </button>
      <a href={url('/')} class="top-brand"><Logo size={22} /> <span>SNAP<b>NEWS</b></span></a>
    </header>

    <div class="shell">
      <Sidebar />
      <div class="scrim" hidden></div>
      <main id="content" class="main">
        <div class="container">
          <slot />
        </div>
      </main>
    </div>

    <noscript><style>.sidebar{position:static!important;transform:none!important;width:auto!important}.menu-btn{display:none!important}</style></noscript>

    <script>
      const body = document.body;
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const scrim = document.querySelector<HTMLDivElement>('.scrim');

      const setMenu = (open: boolean) => {
        body.classList.toggle('menu-open', open);
        btn?.setAttribute('aria-expanded', String(open));
        if (scrim) scrim.hidden = !open;
      };
      btn?.addEventListener('click', () => setMenu(!body.classList.contains('menu-open')));
      scrim?.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

      // Regions dropdown: tap/click the arrow to open or close.
      document.querySelectorAll<HTMLElement>('[data-submenu]').forEach((item) => {
        const toggle = item.querySelector<HTMLButtonElement>('.sub-toggle');
        toggle?.addEventListener('click', () => {
          const open = !item.classList.contains('open');
          item.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
          if (!open) toggle.blur();
        });
      });
    </script>

    <style>
      .topbar {
        position: sticky; top: 0; z-index: 40;
        display: flex; align-items: center; gap: .5rem;
        height: 3.5rem; padding: 0 8px;
        background: var(--sidebar-bg); color: var(--sidebar-ink);
      }
      .menu-btn {
        background: none; border: 0; color: inherit; cursor: pointer;
        width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border-radius: var(--radius);
      }
      .top-brand { display: flex; align-items: center; gap: .45rem; text-decoration: none; color: var(--accent); }
      .top-brand span { font: 800 1.1rem/1 var(--sans); letter-spacing: .04em; color: var(--sidebar-ink); }
      .top-brand b { color: var(--accent); margin-left: .12em; }
      .scrim { position: fixed; inset: 0; background: rgb(0 0 0 / .45); z-index: 45; }
      @media (min-width: 960px) {
        .topbar, .scrim { display: none; }
      }
    </style>
  </body>
</html>
