---
// The "snap": a little spark burst, a nod to a couple thousand snap pops off a second floor.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="spark">
  <g stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
    <line x1="16" y1="2.5" x2="16" y2="9" />
    <line x1="16" y1="23" x2="16" y2="29.5" />
    <line x1="2.5" y1="16" x2="9" y2="16" />
    <line x1="23" y1="16" x2="29.5" y2="16" />
    <line x1="6.5" y1="6.5" x2="10.6" y2="10.6" />
    <line x1="21.4" y1="21.4" x2="25.5" y2="25.5" />
    <line x1="25.5" y1="6.5" x2="21.4" y2="10.6" />
    <line x1="10.6" y1="21.4" x2="6.5" y2="25.5" />
  </g>
  <circle cx="16" cy="16" r="3.4" fill="currentColor" />
</svg>
