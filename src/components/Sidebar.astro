---
import Logo from './Logo.astro';
import { REGIONS, TOPICS, SITE } from '../consts';
import { url } from '../utils/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (p: string) => path === url(p);
const inWorld = path.startsWith(url('/world/'));
---
<aside id="sidebar" class="sidebar" aria-label="Site navigation">
  <a href={url('/')} class="brand">
    <Logo size={30} />
    <span class="brand-name">SNAP<b>NEWS</b></span>
  </a>
  <p class="tagline">{SITE.tagline}</p>

  <nav>
    <ul class="nav">
      <li><a href={url('/')} aria-current={isActive('/') ? 'page' : undefined}>Home</a></li>

      <li class:list={['has-sub', { open: inWorld }]} data-submenu>
        <div class="sub-row">
          <a href={url('/world/')} aria-current={isActive('/world/') ? 'page' : undefined}>World News</a>
          <button class="sub-toggle" type="button" aria-expanded={inWorld ? 'true' : 'false'}
                  aria-controls="regions-menu" aria-label="Show regions">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          </button>
        </div>
        <div class="sub" id="regions-menu">
          <ul>
            {REGIONS.map((r) => (
              <li><a href={url(`/world/${r.slug}/`)} aria-current={isActive(`/world/${r.slug}/`) ? 'page' : undefined}>{r.label}</a></li>
            ))}
          </ul>
        </div>
      </li>

      {TOPICS.map((t) => (
        <li><a href={url(`/${t.slug}/`)} aria-current={isActive(`/${t.slug}/`) ? 'page' : undefined}>{t.label}</a></li>
      ))}
      <li><a href={url('/explained/')} aria-current={isActive('/explained/') ? 'page' : undefined}>Explained</a></li>
    </ul>

    <ul class="nav nav-secondary">
      <li><a href={url('/search/')} aria-current={isActive('/search/') ? 'page' : undefined}>Search</a></li>
      <li><a href={url('/about/')} aria-current={isActive('/about/') ? 'page' : undefined}>About</a></li>
      <li><a href={url('/rss.xml')}>RSS feed</a></li>
    </ul>
  </nav>

  <p class="side-foot">© {new Date().getFullYear()} {SITE.name}</p>
</aside>

<style>
  .sidebar {
    background: var(--sidebar-bg);
    color: var(--sidebar-ink);
    padding: 1.5rem 1rem 1.25rem;
    display: flex; flex-direction: column;
    position: fixed; inset: 0 auto 0 0; width: min(300px, 85vw); z-index: 50;
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform .22s ease;
  }
  :global(body.menu-open) .sidebar { transform: none; }

  @media (min-width: 960px) {
    .sidebar { position: sticky; top: 0; height: 100vh; width: auto; transform: none; transition: none; }
  }

  .brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; color: var(--accent); padding: 0 .5rem; }
  .brand-name { font: 800 1.35rem/1 var(--sans); letter-spacing: .04em; color: var(--sidebar-ink); }
  .brand-name b { color: var(--accent); font-weight: 800; margin-left: .15em; }
  .tagline { font-size: .8rem; color: var(--sidebar-soft); margin: .75rem .5rem 1.5rem; line-height: 1.4; }

  .nav { list-style: none; margin: 0; padding: 0; }
  .nav a {
    display: block; padding: .55rem .75rem; border-radius: var(--radius);
    color: var(--sidebar-ink); text-decoration: none; font-weight: 600; font-size: .98rem;
  }
  .nav a:hover, .sub-toggle:hover { background: var(--sidebar-hover); color: #fff; }
  .nav a[aria-current='page'] { background: var(--sidebar-hover); box-shadow: inset 3px 0 0 var(--accent); }

  .nav-secondary { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid #2c2f36; }
  .nav-secondary a { font-weight: 500; color: var(--sidebar-soft); font-size: .9rem; }

  .sub-row { display: flex; align-items: center; }
  .sub-row a { flex: 1; }
  .sub-toggle {
    background: none; border: 0; color: var(--sidebar-soft); cursor: pointer;
    width: 2.25rem; height: 2.25rem; border-radius: var(--radius); display: grid; place-items: center;
  }
  .sub-toggle svg { transition: transform .2s ease; }

  .sub {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows .2s ease;
  }
  .sub > ul {
    min-height: 0; overflow: hidden;
    list-style: none; margin: 0 0 0 .75rem; padding: 0 0 0 .5rem;
    border-left: 1px solid #2c2f36;
  }
  .sub a { font-weight: 500; font-size: .9rem; padding: .4rem .75rem; color: var(--sidebar-soft); }

  /* The dropdown: opens on hover (mouse), on keyboard focus, or when tapped / on a World page. */
  .has-sub.open .sub,
  .has-sub:focus-within .sub { grid-template-rows: 1fr; }
  .has-sub.open .sub-toggle svg,
  .has-sub:focus-within .sub-toggle svg { transform: rotate(90deg); }
  @media (hover: hover) {
    .has-sub:hover .sub { grid-template-rows: 1fr; }
    .has-sub:hover .sub-toggle svg { transform: rotate(90deg); }
  }
  /* Collapsed regions should not be reachable by Tab until opened. */
  .has-sub:not(.open):not(:focus-within):not(:hover) .sub { visibility: hidden; }

  .side-foot { margin-top: auto; padding: 1.5rem .5rem 0; font-size: .75rem; color: var(--sidebar-soft); }
</style>
