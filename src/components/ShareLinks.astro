---
// Plain share links. No third-party share widgets or scripts, so readers aren't tracked.
interface Props { title: string; url: string }
const { title, url } = Astro.props;
const t = encodeURIComponent(title);
const u = encodeURIComponent(url);
const links = [
  { label: 'X', href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { label: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}` },
  { label: 'Telegram', href: `https://t.me/share/url?url=${u}&text=${t}` },
  { label: 'Reddit', href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
  { label: 'Email', href: `mailto:?subject=${t}&body=${u}` },
];
---
<div class="share">
  <span class="label">Share</span>
  {links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
  <button type="button" class="copy" data-url={url}>Copy link</button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share .copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
        btn.textContent = 'Copied!';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = 'Copy link'), 2000);
    });
  });
</script>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-top: 2.5rem; padding-top: 1.25rem; border-top: 3px solid var(--ink); }
  .label { font: 800 .75rem var(--sans); text-transform: uppercase; letter-spacing: .1em; margin-right: .25rem; }
  a, button {
    font: 600 .82rem var(--sans); color: var(--ink); text-decoration: none; cursor: pointer;
    border: 1px solid var(--rule); background: var(--surface); border-radius: 999px; padding: .35rem .8rem;
  }
  a:hover, button:hover { border-color: var(--accent); color: var(--accent-ink); }
</style>
