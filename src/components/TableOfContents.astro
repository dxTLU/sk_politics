---
// "In this piece" contents box for long articles. Pure HTML (<details>), no script needed.
interface Props { headings: { depth: number; slug: string; text: string }[] }
const { headings } = Astro.props;
---
<details class="toc" open>
  <summary>In this piece</summary>
  <ol>
    {headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
  </ol>
</details>

<style>
  .toc { border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface); margin: 0 0 2rem; padding: .85rem 1.1rem; }
  summary { cursor: pointer; font: 800 .75rem var(--sans); text-transform: uppercase; letter-spacing: .1em; }
  summary::marker { color: var(--accent); }
  ol { margin: .7rem 0 .1rem; padding-left: 1.3rem; }
  li { margin: .3rem 0; }
  li::marker { color: var(--ink-faint); font-weight: 700; }
  a { text-decoration: none; font-weight: 600; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media print { .toc { display: none; } }
</style>
